# ============================================================
# CHATCONNECT ENVIRONMENT CONFIGURATION (.env.example)
# Copy this to backend/.env and frontend/.env.local
# ============================================================

# PORT & SERVER
PORT=5000
NODE_ENV=development

# FRONTEND CLIENT URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# AUTHENTICATION
JWT_SECRET=chatconnect_super_secret_jwt_key_hackathon_2026
JWT_EXPIRATION=7d

# ------------------------------------------------------------
# 1. AIVEN POSTGRESQL (Permanent Storage)
# Example: postgres://avnadmin:pass@pg-chatconnect.aivencloud.com:12345/defaultdb?sslmode=require
# If empty or unreachable, ChatConnect seamlessly falls back to high-speed local engine
# ------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------
# 2. AIVEN APACHE KAFKA (Event Streaming Architecture)
# Example: kafka-chatconnect.aivencloud.com:12347
# If empty or unreachable, ChatConnect seamlessly utilizes an internal event-driven broker
# ------------------------------------------------------------
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=true

# ------------------------------------------------------------
# 3. AIVEN VALKEY (Low-Latency Presence, Typing & Cache)
# Example: rediss://default:pass@valkey-chatconnect.aivencloud.com:12349
# If empty or unreachable, ChatConnect runs high-speed in-memory Valkey adapter
# ------------------------------------------------------------
VALKEY_URL=

# ------------------------------------------------------------
# 4. AI INTEGRATION (Modular Secondary Utility)
# Google Gemini / OpenAI / Anthropic API Key
# If empty, graceful smart heuristic mock response is returned
# ------------------------------------------------------------
GEMINI_API_KEY=
AI_API_KEY=
